{
  "name": "atm",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev_later": "concurrently \"pnpm run dev:db\" \"nuxt dev\"",
    "dev:db": "turso dev --db-file local.db",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "deploy:vercel:preview": "vercel --yes",
    "deploy:vercel:prod": "vercel --prod --yes",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix --fix-type problem,suggestion,layout",
    "typecheck": "nuxi typecheck",
    "prepare": "husky || echo \"husky skipped\"",
    "center-logos": "node scripts/center-logos.js",
    "db:seed-divisions": "tsx scripts/seed-divisions.ts",
    "db:seed-nearby-venues": "tsx scripts/seed-nearby-venues.ts",
    "db:ensure-distance-unit": "tsx scripts/ensure-distance-unit-column.ts",
    "db:ensure-latest-schema": "tsx scripts/ensure-latest-schema-columns.ts",
    "db:migrate:cloud": "tsx scripts/migrate-cloud-schema.ts",
    "db:sync-local-to-remote": "tsx scripts/sync-local-to-remote.ts",
    "db:sync-remote-to-local": "tsx scripts/sync-remote-to-local.ts",
    "env:sync:cloud": "tsx scripts/sync-cloud-env.ts",
    "env:sync:github": "tsx scripts/sync-cloud-env.ts --github-only",
    "env:sync:vercel": "tsx scripts/sync-cloud-env.ts --vercel-only"
  },
  "dependencies": {
    "@iconify-json/tabler": "^1.2.38",
    "@libsql/client": "^0.17.4",
    "@nuxt/eslint": "1.17.0",
    "@nuxtjs/color-mode": "4.0.1",
    "@pinia/nuxt": "1.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "better-auth": "^1.6.26",
    "drizzle-orm": "^0.45.2",
    "h3": "2.0.1-rc.26",
    "leaflet": "^1.9.4",
    "nitropack": "^2.13.4",
    "nodemailer": "^9.0.4",
    "nuxt": "^4.5.2",
    "ofetch": "^1.5.1",
    "pinia": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@nuxt/icon": "2.4.1",
    "@types/leaflet": "^1.9.22",
    "@types/nodemailer": "^8.0.1",
    "daisyui": "^5.7.16",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.9",
    "vue-tsc": "3.3.9"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
